# Secrets. NEVER commit this file — it holds ANTHROPIC_API_KEY.
.env
.env.*

# Python bytecode.
__pycache__/
*.pyc

# Pipeline state. Every one of these holds a server-side ID that is personal to
# whoever ran the scripts. With several teammates working from one fork they
# collide in every commit, and a stale ID silently points a run at somebody
# else's agents. Regenerate them by re-running the build chain; never share them.
.environment_id
.specialist_ids.json
.coordinator_id
.skill_ids.json
.last_session_id

# Generated deliverables. Re-fetch with `python3 download_deliverable.py`.
outputs/
